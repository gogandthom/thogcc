---
Checks: >
  -*,
  performance-*,
  readability-*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  mpi-*,
  misc-*,
  -readability-identifier-length
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: 1
HeaderFilterRegex: "include/.*"
FormatStyle: file
SystemHeaders: false
